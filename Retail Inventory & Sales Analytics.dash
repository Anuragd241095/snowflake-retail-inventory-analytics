        {
          "tile_id": "chart-f71ef1db43a4",
          "title": "Monthly Sales",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "title": "",
            "usermeta": {
              "snowflake": {
                "chartConfig": {
                  "dataLabels": {
                    "enabled": true
                  },
                  "format": {
                    "abbreviateNumbers": true
                  },
                  "dataPoints": {
                    "enabled": true
                  }
                },
                "chartType": "line"
              }
            },
            "layer": [
              {
                "mark": {
                  "type": "line",
                  "invalid": null,
                  "point": true
                },
                "encoding": {
                  "x": {
                    "scale": {
                      "type": "utc"
                    },
                    "field": "SALES_MONTH",
                    "type": "temporal",
                    "sort": "ascending"
                  },
                  "y": {
                    "field": "MONTHLY_SALES",
                    "type": "quantitative",
                    "aggregate": "sum",
                    "axis": {
                      "labelExpr": "abs(datum.value) >= 1000 ? format(datum.value, '.3~s') : format(datum.value, '')"
                    }
                  },
                  "tooltip": [
                    {
                      "field": "SALES_MONTH"
                    },
                    {
                      "field": "MONTHLY_SALES",
                      "aggregate": "sum"
                    }
                  ]
                }
              },
              {
                "mark": {
                  "type": "text",
                  "dy": -8,
                  "clip": false
                },
                "encoding": {
                  "x": {
                    "scale": {
                      "type": "utc"
                    },
                    "field": "SALES_MONTH",
                    "type": "temporal",
                    "sort": "ascending"
                  },
                  "y": {
                    "field": "MONTHLY_SALES",
                    "type": "quantitative",
                    "aggregate": "sum",
                    "axis": {
                      "labelExpr": "abs(datum.value) >= 1000 ? format(datum.value, '.3~s') : format(datum.value, '')"
                    }
                  },
                  "text": {
                    "field": "MONTHLY_SALES",
                    "aggregate": "sum",
                    "format": ".3~s"
                  }
                }
              }
            ]
          },
          "datasources": [
            "ds-chart-f71ef1db43a4"
          ]
        },
