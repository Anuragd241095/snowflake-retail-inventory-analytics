  "datasources": {
    "ds-chart-f71ef1db43a4": {
      "type": "sql",
      "columns": [
        {
          "name": "SALES_MONTH",
          "type": "DATE"
        },
        {
          "name": "MONTHLY_SALES",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    DATE_TRUNC('MONTH', DATE) AS SALES_MONTH,\n    ROUND(SUM(ESTIMATED_NET_SALES), 2)\n        AS MONTHLY_SALES\nFROM RETAIL_DB.ANALYTICS.DAILY_SALES\nGROUP BY 1\nHAVING COUNT(DISTINCT DATE) =\n       DAY(LAST_DAY(DATE_TRUNC('MONTH', DATE)))\nORDER BY 1;\n\n",
      "filter_bindings": []
    },
    "ds-chart-544f026ba64c": {
      "type": "sql",
      "columns": [
        {
          "name": "PRODUCT_ID",
          "type": "VARCHAR"
        },
        {
          "name": "TOTAL_UNITS_SOLD",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    PRODUCT_ID,\n    TOTAL_UNITS_SOLD\nFROM RETAIL_DB.ANALYTICS.PRODUCT_PERFORMANCE\nORDER BY TOTAL_UNITS_SOLD DESC\nLIMIT 10;\n",
      "filter_bindings": []
    },
    "ds-chart-877adfdc20fd": {
      "type": "sql",
      "columns": [
        {
          "name": "STOCK_STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "TOTAL_PRODUCTS",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    STOCK_STATUS,\n    COUNT(*) AS TOTAL_PRODUCTS\nFROM RETAIL_DB.ANALYTICS.LATEST_INVENTORY\nGROUP BY STOCK_STATUS\nORDER BY TOTAL_PRODUCTS DESC;\n",
      "filter_bindings": []
    },
    "ds-chart-33d8ba9cfb2b": {
      "type": "sql",
      "columns": [
        {
          "name": "STORE_ID",
          "type": "VARCHAR"
        },
        {
          "name": "TOTAL_SALES",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    STORE_ID,\n    ROUND(SUM(ESTIMATED_NET_SALES), 2)\n        AS TOTAL_SALES\nFROM RETAIL_DB.ANALYTICS.DAILY_SALES\nGROUP BY STORE_ID\nORDER BY TOTAL_SALES DESC;\n",
      "filter_bindings": []
    },
    "ds-chart-8f08cef24885": {
      "type": "sql",
      "columns": [
        {
          "name": "CATEGORY",
          "type": "VARCHAR"
        },
        {
          "name": "INVENTORY_VALUE",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    CATEGORY,\n    ROUND(\n        SUM(ESTIMATED_INVENTORY_VALUE), 2\n    ) AS INVENTORY_VALUE\nFROM RETAIL_DB.ANALYTICS.LATEST_INVENTORY\nGROUP BY CATEGORY\nORDER BY INVENTORY_VALUE DESC;\n",
      "filter_bindings": []
    },
    "ds-chart-13b0818f54f3": {
      "type": "sql",
      "columns": [
        {
          "name": "TOTAL_ESTIMATED_SALES",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    ROUND(SUM(ESTIMATED_NET_SALES), 2)\n        AS TOTAL_ESTIMATED_SALES\nFROM RETAIL_DB.ANALYTICS.DAILY_SALES;\n",
      "filter_bindings": []
    },
    "ds-chart-84ead949f765": {
      "type": "sql",
      "columns": [
        {
          "name": "INVENTORY_DAYS_OF_SUPPLY",
          "type": "NUMBER"
        }
      ],
      "sql": "\nWITH SNAPSHOT AS (\n    SELECT\n        MAX(DATE) AS SNAPSHOT_DATE,\n        SUM(INVENTORY_LEVEL) AS STOCK_UNITS\n    FROM RETAIL_DB.ANALYTICS.LATEST_INVENTORY\n),\n\nSALES_30_DAYS AS (\n    SELECT\n        SUM(C.UNITS_SOLD) / 30.0 AS AVG_DAILY_SALES\n    FROM RETAIL_DB.CLEAN.RETAIL_INVENTORY_CLEAN C\n    CROSS JOIN SNAPSHOT S\n    WHERE C.DATE > DATEADD(DAY, -30, S.SNAPSHOT_DATE)\n      AND C.DATE <= S.SNAPSHOT_DATE\n)\n\nSELECT\n    ROUND(\n        S.STOCK_UNITS /\n        NULLIF(A.AVG_DAILY_SALES, 0),\n        1\n    ) AS INVENTORY_DAYS_OF_SUPPLY\nFROM SNAPSHOT S\nCROSS JOIN SALES_30_DAYS A;\n",
      "filter_bindings": []
    },
    "ds-chart-13f449435b9b": {
      "type": "sql",
      "columns": [
        {
          "name": "AVAILABLE_STOCK_UNITS",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    SUM(INVENTORY_LEVEL) AS AVAILABLE_STOCK_UNITS\nFROM RETAIL_DB.ANALYTICS.LATEST_INVENTORY;\n",
      "filter_bindings": []
    },
    "ds-chart-4c41d6f77777": {
      "type": "sql",
      "columns": [
        {
          "name": "AVG_DAILY_UNITS_SOLD",
          "type": "NUMBER"
        }
      ],
      "sql": "\nSELECT\n    ROUND(\n        SUM(UNITS_SOLD) /\n        NULLIF(COUNT(DISTINCT DATE), 0),\n        0\n    ) AS AVG_DAILY_UNITS_SOLD\nFROM RETAIL_DB.CLEAN.RETAIL_INVENTORY_CLEAN;\n",
      "filter_bindings": []
    }
  }
}