        {
          "tile_id": "chart-13b0818f54f3",
          "title": "Total Estimated Sales",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "width": 400,
            "height": 200,
            "padding": 0,
            "params": [
              {
                "name": "__scorecard_reveal",
                "value": 1
              },
              {
                "name": "__scorecard_pulse",
                "value": 0
              }
            ],
            "data": {
              "name": "values"
            },
            "transform": [
              {
                "calculate": "(isValid(datum['TOTAL_ESTIMATED_SALES']) && isNumber(datum['TOTAL_ESTIMATED_SALES'])) ? (abs(datum['TOTAL_ESTIMATED_SALES']) >= 1e9 ? format(datum['TOTAL_ESTIMATED_SALES'] / 1e9, '.0~f') + 'B' : abs(datum['TOTAL_ESTIMATED_SALES']) >= 1e6 ? format(datum['TOTAL_ESTIMATED_SALES'] / 1e6, '.0~f') + 'M' : abs(datum['TOTAL_ESTIMATED_SALES']) >= 1e3 ? format(datum['TOTAL_ESTIMATED_SALES'] / 1e3, '.0~f') + 'K' : format(datum['TOTAL_ESTIMATED_SALES'], ',.0~f')) : 'N/A'",
                "as": "bigNumberText"
              },
              {
                "calculate": "'neutral'",
                "as": "__toneKey"
              },
              {
                "calculate": "!(isValid(datum['TOTAL_ESTIMATED_SALES']) && isNumber(datum['TOTAL_ESTIMATED_SALES'])) ? '#5d6a85' : ('#1e252f')",
                "as": "__numberColor"
              },
              {
                "calculate": "'neutral'",
                "as": "__chartKey"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__lineColor"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__chartColor"
              }
            ],
            "layer": [
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontWeight": "bold",
                  "fontSize": {
                    "expr": "width >= 140 ? 40 : (width >= 90 ? 24 : 14)"
                  },
                  "limit": {
                    "expr": "width - 8"
                  },
                  "color": {
                    "expr": "datum['__numberColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2"
                    }
                  },
                  "text": {
                    "field": "bigNumberText"
                  }
                }
              }
            ],
            "config": {
              "view": {
                "stroke": null
              },
              "mark": {
                "tooltip": false
              }
            },
            "usermeta": {
              "snowflake": {
                "chartConfig": {
                  "dataLabels": {
                    "enabled": false
                  },
                  "format": {
                    "abbreviateNumbers": true
                  }
                },
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "TOTAL_ESTIMATED_SALES",
                  "labelField": "",
                  "format": "decimal",
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "prevColumn": "",
                  "seriesField": "",
                  "seriesBucketField": "",
                  "seriesValueField": ""
                }
              }
            },
            "title": ""
          },
          "datasources": [
            "ds-chart-13b0818f54f3"
          ]
        },
        {
          "tile_id": "chart-84ead949f765",
          "title": "Inventory Days of Supply",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "width": 400,
            "height": 200,
            "padding": 0,
            "params": [
              {
                "name": "__scorecard_reveal",
                "value": 1
              },
              {
                "name": "__scorecard_pulse",
                "value": 0
              }
            ],
            "data": {
              "name": "values"
            },
            "transform": [
              {
