        {
          "tile_id": "chart-877adfdc20fd",
          "title": "Inventory Stock Status Distribution",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "title": "",
            "usermeta": {
              "snowflake": {
                "chartConfig": {
                  "dataLabels": {
                    "enabled": true
                  },
                  "format": {
                    "abbreviateNumbers": true
                  },
                  "centerTotal": {
                    "enabled": false
                  },
                  "innerRadius": 40
                },
                "chartType": "arc"
              }
            },
            "layer": [
              {
                "mark": {
                  "type": "arc",
                  "innerRadius": {
                    "expr": "min(width, height) / 2 * 0.4"
                  }
                },
                "encoding": {
                  "color": {
                    "field": "STOCK_STATUS",
                    "type": "nominal",
                    "scale": {
                      "scheme": "category10"
                    }
                  },
                  "theta": {
                    "field": "TOTAL_PRODUCTS",
                    "type": "quantitative",
                    "aggregate": "sum"
                  },
                  "tooltip": [
                    {
                      "field": "STOCK_STATUS"
                    },
                    {
                      "field": "TOTAL_PRODUCTS",
                      "aggregate": "sum"
                    }
                  ]
                },
                "transform": [
                  {
                    "joinaggregate": [
                      {
                        "op": "sum",
                        "as": "__pieCategoryTotal",
                        "field": "TOTAL_PRODUCTS"
                      }
                    ],
                    "groupby": [
                      "STOCK_STATUS"
                    ]
                  },
                  {
                    "window": [
                      {
                        "op": "dense_rank",
                        "as": "__pieCategoryRank"
                      }
                    ],
                    "sort": [
                      {
                        "field": "__pieCategoryTotal",
                        "order": "descending"
                      },
                      {
                        "field": "STOCK_STATUS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__pieCategoryRank <= 20 ? datum[\"STOCK_STATUS\"] : \"Other\"",
                    "as": "STOCK_STATUS"
                  }
                ]
              },
              {
                "mark": {
                  "type": "rule",
                  "clip": false
                },
                "encoding": {
                  "opacity": {
                    "condition": {
                      "test": "datum[\"__percent\"] < 0.01",
                      "value": 0
                    },
                    "value": 1
                  },
                  "x": {
                    "field": "__pieLabelX1",
                    "type": "quantitative",
                    "scale": null
                  },
                  "y": {
                    "field": "__pieLabelY1",
                    "type": "quantitative",
                    "scale": null
                  },
                  "x2": {
                    "field": "__pieLabelRuleX2"
                  },
                  "y2": {
                    "field": "__pieLabelRuleY2"
                  }
                },
                "transform": [
                  {
                    "joinaggregate": [
                      {
                        "op": "sum",
                        "as": "__pieCategoryTotal",
                        "field": "TOTAL_PRODUCTS"
                      }
                    ],
                    "groupby": [
                      "STOCK_STATUS"
                    ]
                  },
                  {
                    "window": [
                      {
                        "op": "dense_rank",
                        "as": "__pieCategoryRank"
                      }
                    ],
                    "sort": [
                      {
                        "field": "__pieCategoryTotal",
                        "order": "descending"
                      },
                      {
                        "field": "STOCK_STATUS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__pieCategoryRank <= 20 ? datum[\"STOCK_STATUS\"] : \"Other\"",
                    "as": "STOCK_STATUS"
                  },
                  {
                    "aggregate": [
                      {
                        "op": "sum",
                        "field": "TOTAL_PRODUCTS",
                        "as": "__pieLabelValue"
                      }
                    ],
                    "groupby": [
                      "STOCK_STATUS"
                    ]
                  },
                  {
                    "stack": "__pieLabelValue",
                    "groupby": [],
                    "as": [
                      "__pieLabelStart",
                      "__pieLabelEnd"
                    ],
                    "sort": [
                      {
                        "field": "STOCK_STATUS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "sum",
                        "field": "__pieLabelValue",
                        "as": "__pieLabelTotal"
                      }
                    ]
                  },
                  {
                    "calculate": "datum[\"__pieLabelValue\"] / datum[\"__pieLabelTotal\"]",
                    "as": "__percent"
                  },
                  {
                    "calculate": "(datum[\"__pieLabelStart\"] + datum[\"__pieLabelEnd\"]) / 2 / datum[\"__pieLabelTotal\"] * 2 * PI",
                    "as": "__pieLabelMidAngle"
                  },
                  {
                    "calculate": "min(width, height) / 2",
                    "as": "__pieLabelBaseRadius"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelX1"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelY1"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1.18 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelX2"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1.18 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelY2"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1.0899999999999999 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelRuleX2"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1.0899999999999999 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelRuleY2"
                  }
                ]
              },
              {
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "clip": false
                },
                "encoding": {
                  "x": {
                    "field": "__pieLabelX2",
                    "type": "quantitative",
                    "scale": null
                  },
                  "y": {
                    "field": "__pieLabelY2",
                    "type": "quantitative",
                    "scale": null
                  },
                  "text": {
                    "condition": {
                      "test": "datum[\"__percent\"] < 0.01",
                      "value": ""
                    },
                    "field": "__pieLabelValue",
                    "type": "quantitative",
                    "format": ".3~s"
                  }
                },
                "transform": [
                  {
                    "joinaggregate": [
                      {
                        "op": "sum",
                        "as": "__pieCategoryTotal",
                        "field": "TOTAL_PRODUCTS"
                      }
                    ],
                    "groupby": [
                      "STOCK_STATUS"
                    ]
                  },
                  {
                    "window": [
                      {
                        "op": "dense_rank",
                        "as": "__pieCategoryRank"
                      }
                    ],
                    "sort": [
                      {
                        "field": "__pieCategoryTotal",
                        "order": "descending"
                      },
                      {
                        "field": "STOCK_STATUS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__pieCategoryRank <= 20 ? datum[\"STOCK_STATUS\"] : \"Other\"",
                    "as": "STOCK_STATUS"
                  },
                  {
                    "aggregate": [
                      {
                        "op": "sum",
                        "field": "TOTAL_PRODUCTS",
                        "as": "__pieLabelValue"
                      }
                    ],
                    "groupby": [
                      "STOCK_STATUS"
                    ]
                  },
                  {
                    "stack": "__pieLabelValue",
                    "groupby": [],
                    "as": [
                      "__pieLabelStart",
                      "__pieLabelEnd"
                    ],
                    "sort": [
                      {
                        "field": "STOCK_STATUS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "sum",
                        "field": "__pieLabelValue",
                        "as": "__pieLabelTotal"
                      }
                    ]
                  },
                  {
                    "calculate": "datum[\"__pieLabelValue\"] / datum[\"__pieLabelTotal\"]",
                    "as": "__percent"
                  },
                  {
                    "calculate": "(datum[\"__pieLabelStart\"] + datum[\"__pieLabelEnd\"]) / 2 / datum[\"__pieLabelTotal\"] * 2 * PI",
                    "as": "__pieLabelMidAngle"
                  },
                  {
                    "calculate": "min(width, height) / 2",
                    "as": "__pieLabelBaseRadius"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelX1"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelY1"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1.18 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelX2"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1.18 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelY2"
                  },
                  {
                    "calculate": "width / 2 + datum[\"__pieLabelBaseRadius\"] * 1.0899999999999999 * sin(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelRuleX2"
                  },
                  {
                    "calculate": "height / 2 - datum[\"__pieLabelBaseRadius\"] * 1.0899999999999999 * cos(datum[\"__pieLabelMidAngle\"])",
                    "as": "__pieLabelRuleY2"
                  }
                ]
              }
            ]
          },
          "datasources": [
            "ds-chart-877adfdc20fd"
          ]
        },
